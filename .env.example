# توکن ربات از BotFather (این توکن را هرگز در گیت‌هاب کامیت نکن!)
BOT_TOKEN=

# آیدی عددی ادمین‌ها، با کاما جدا شده
ADMIN_IDS=1953490397,98064300

# رشته اتصال دیتابیس Postgres (مثلا از Neon، از تب Storage در Vercel می‌گیری)
DATABASE_URL=

# یک رشته تصادفی دلخواه برای اعتبارسنجی وبهوک تلگرام
WEBHOOK_SECRET=change-me-to-a-random-string

# یک رشته تصادفی دلخواه برای محافظت از /api/set_webhook و /api/cron
CRON_SECRET=change-me-too

# اختیاری
MAX_MESSAGES_PER_MINUTE=5
